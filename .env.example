# Database
MONGODB_URI=mongodb://localhost:27017/reelbeat

# Security & App
JWT_SECRET=your_jwt_secret_key_here
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Administrator Credentials (Placeholders)
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_NAME=Admin Name

# Storage Configuration (local or r2)
STORAGE_PROVIDER=local
MAX_FILE_SIZE_GB=5
STORAGE_PATH=./storage

# Cloudflare R2 Storage (Optional: only needed if STORAGE_PROVIDER=r2)
R2_BUCKET=reelbeat-media
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev
